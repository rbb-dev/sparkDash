# mgllm's sparkDash on the gateway: MiaAI-Lab's app at pins.env's commit with patches/, built on the workstation by
# scripts/deploy-gateway.sh (VITE_BASE=/sparkdash/) and copied in ready to run. Every Spark is read through its
# sparkdash-api (execUrl), so unlike her own image this one carries no SSH client and mounts nothing from the host.
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
FROM ${NODE_IMAGE}
WORKDIR /app
COPY app/ ./
ENV NODE_ENV=production
USER node
CMD ["node", "server/index.js"]
